---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/motion/Reveal.tsx";
import TennisEgg from "../components/TennisEgg.tsx";
import FloatingPhoto from "../components/FloatingPhoto.tsx";
import RippleBackground from "../components/RippleBackground.tsx";
---

<BaseLayout
  title="Yasseen Hilal – Software Engineer"
  description="Yasseen Hilal is a software engineer interning at Visa, with prior internships at Paycom and re:3D. CS student at UT Austin, Class of 2027."
  personSchema
>
  <section class="home-hero">
    <RippleBackground client:load />
    <div class="hero-layout">
      <div class="hero-copy">
        <Reveal client:load>
          <p class="hero-intro">Software engineer. Always building.</p>
        </Reveal>
        <Reveal client:load delay={0.1}>
          <h1 class="hero-name">Yasseen<span>Hilal<span class="name-period">.</span></span></h1>
        </Reveal>
        <Reveal client:load delay={0.2}>
          <p class="hero-description">I'm a SWE interning at Visa, after internships at Paycom and re:3D. I'm finishing my CS degree at UT, looking ahead to new grad roles in software engineering.</p>
        </Reveal>
      </div>
      <FloatingPhoto client:load src="/images/yasseen.webp" alt="Yasseen Hilal" width={900} height={1200} />
    </div>
    <div class="hero-bottom">
      <p>UT Austin Computer Science <span>Class of 2027</span></p>
      <TennisEgg client:idle />
    </div>
  </section>
</BaseLayout>
